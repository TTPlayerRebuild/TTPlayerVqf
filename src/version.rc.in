      VALUE "OriginalFilename", "ttp_vqf.dll\0"
      VALUE "ProductName", "TTPlayer Rebuild VQF\0"
      VALUE "ProductVersion", "@VQF_BUILD_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
